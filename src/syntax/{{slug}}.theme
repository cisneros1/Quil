{
    "_comments": [
        "{{full_name}} syntax highlighting for Kate, KWrite and every other KTextEditor app.",
        "Generated from palette.json by tools/build.py."
    ],
    "metadata": {
        "name": "{{full_name}}",
        "revision": 1,
        "copyright": [
            "SPDX-FileCopyrightText: {{author}}"
        ],
        "license": "SPDX-License-Identifier: {{license}}"
    },
    "text-styles": {
        "Normal":         { "text-color": "{{fg}}", "selected-text-color": "{{fg}}" },
        "Keyword":        { "text-color": "{{accent}}", "selected-text-color": "{{accent}}", "bold": true },
        "Function":       { "text-color": "{{term_blue}}", "selected-text-color": "{{term_blue}}" },
        "Variable":       { "text-color": "{{link}}", "selected-text-color": "{{link}}" },
        "ControlFlow":    { "text-color": "{{term_magenta}}", "selected-text-color": "{{term_magenta}}", "bold": true },
        "Operator":       { "text-color": "{{fg}}", "selected-text-color": "{{fg}}" },
        "BuiltIn":        { "text-color": "{{term_magenta}}", "selected-text-color": "{{term_magenta}}" },
        "Extension":      { "text-color": "{{term_blue}}", "selected-text-color": "{{term_blue}}", "bold": true },
        "Preprocessor":   { "text-color": "{{neutral}}", "selected-text-color": "{{neutral}}" },
        "Attribute":      { "text-color": "{{term_yellow}}", "selected-text-color": "{{term_yellow}}" },
        "Char":           { "text-color": "{{positive}}", "selected-text-color": "{{positive}}" },
        "SpecialChar":    { "text-color": "{{neutral}}", "selected-text-color": "{{neutral}}" },
        "String":         { "text-color": "{{positive}}", "selected-text-color": "{{positive}}" },
        "VerbatimString": { "text-color": "{{positive}}", "selected-text-color": "{{positive}}" },
        "SpecialString":  { "text-color": "{{negative}}", "selected-text-color": "{{negative}}" },
        "Import":         { "text-color": "{{term_magenta}}", "selected-text-color": "{{term_magenta}}" },
        "DataType":       { "text-color": "{{visited}}", "selected-text-color": "{{visited}}" },
        "DecVal":         { "text-color": "{{neutral}}", "selected-text-color": "{{neutral}}" },
        "BaseN":          { "text-color": "{{neutral}}", "selected-text-color": "{{neutral}}" },
        "Float":          { "text-color": "{{neutral}}", "selected-text-color": "{{neutral}}" },
        "Constant":       { "text-color": "{{term_yellow}}", "selected-text-color": "{{term_yellow}}", "bold": true },
        "Comment":        { "text-color": "{{fg_muted}}", "selected-text-color": "{{fg_muted}}", "italic": true },
        "Documentation":  { "text-color": "{{fg_muted}}", "selected-text-color": "{{fg_muted}}" },
        "Annotation":     { "text-color": "{{term_magenta}}", "selected-text-color": "{{term_magenta}}", "italic": true },
        "CommentVar":     { "text-color": "{{visited}}", "selected-text-color": "{{visited}}" },
        "RegionMarker":   { "text-color": "{{term_blue}}", "selected-text-color": "{{term_blue}}", "background-color": "{{accent 12% on view}}" },
        "Information":    { "text-color": "{{term_yellow}}", "selected-text-color": "{{term_yellow}}" },
        "Warning":        { "text-color": "{{neutral}}", "selected-text-color": "{{neutral}}" },
        "Alert":          { "text-color": "{{negative}}", "selected-text-color": "{{negative}}", "bold": true, "background-color": "{{negative 18% on view}}" },
        "Error":          { "text-color": "{{negative}}", "selected-text-color": "{{negative}}", "underline": true },
        "Others":         { "text-color": "{{term_blue}}", "selected-text-color": "{{term_blue}}" }
    },
    "editor-colors": {
        "BackgroundColor": "{{view}}",
        "CodeFolding": "{{accent 12% on view}}",
        "BracketMatching": "{{accent 40% on view}}",
        "CurrentLine": "{{view_alt}}",
        "IconBorder": "{{view}}",
        "IndentationLine": "{{fg_muted 35% on view}}",
        "LineNumbers": "{{fg_muted}}",
        "CurrentLineNumber": "{{fg}}",
        "MarkBookmark": "{{term_blue}}",
        "MarkBreakpointActive": "{{negative}}",
        "MarkBreakpointReached": "{{term_yellow}}",
        "MarkBreakpointDisabled": "{{term_magenta}}",
        "MarkExecution": "{{fg_muted}}",
        "MarkWarning": "{{neutral}}",
        "MarkError": "{{negative}}",
        "TemplateBackground": "{{bg_alt}}",
        "TemplatePlaceholder": "{{accent 25% on view}}",
        "TemplateFocusedPlaceholder": "{{accent 45% on view}}",
        "TemplateReadOnlyPlaceholder": "{{negative 25% on view}}",
        "ModifiedLines": "{{neutral}}",
        "SavedLines": "{{positive}}",
        "SearchHighlight": "{{term_yellow 32% on view}}",
        "ReplaceHighlight": "{{neutral 32% on view}}",
        "Separator": "{{fg_muted 30% on view}}",
        "SpellChecking": "{{negative}}",
        "TabMarker": "{{fg_muted 30% on view}}",
        "TextSelection": "{{accent 28% on view}}",
        "WordWrapMarker": "{{fg_muted 20% on view}}"
    }
}
