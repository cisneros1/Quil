# {{full_name}} Konsole colors. Generated from palette.json by tools/build.py.
# Translucent with blur, like Quil's menus and Dolphin.

[General]
Description={{full_name}}
Opacity=0.8
Blur=true
Wallpaper=

[Background]
Color={{view.rgb}}

[BackgroundIntense]
Color={{bg_alt.rgb}}

[BackgroundFaint]
Color={{view.rgb}}

[Foreground]
Color={{fg.rgb}}

[ForegroundIntense]
Color={{fg.rgb}}
Bold=true

[ForegroundFaint]
Color={{fg_muted.rgb}}

